# Copia a .env y completa. NUNCA subas secretos reales al repositorio.
# Si GEMINI_API_KEY está vacío, el agente usa un LLM simulado (mock).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DATABASE_URL=sqlite:///./cuantico.db

# Tokens de desarrollo local con sus alcances:
# Formato: token:alcance ; alcance = "all" o ids de comercio separados por coma
API_TOKENS=tok-ops-admin:all;tok-la80-001:m-la80;tok-cafe-001:m-cafe
